;; Synthetic auto models that are fallback chains rather than rankings
;; (auto:vision, auto:cephalon[:cheapest|:fastest|:smartest]) and the shared rule for
;; moving on to the next candidate. Consumed by proxx.strategy.chains.
[{:contract/id :auto-chains/default
  :contract/kind :auto-model-chains
  :chains/max-candidates {:default 8 :ceiling 24}

  ;; Move to the next model/provider candidate when the previous attempt saw any of these.
  :chains/advance-on [:saw-rate-limit :saw-request-error :saw-upstream-server-error
                      :saw-model-not-found :saw-model-not-supported-for-account]

  ;; auto:vision: tried in order, those the catalog offers (else the whole chain).
  :chains/vision
  {:model-chain ["glm-5v-turbo" "Kimi-K2.5" "gpt-5.4-mini" "qwen3.5:4b-q8_0"]
   ;; Provider ordering for the routed model: the first rule that matches puts the
   ;; matching providers first (stable); no match keeps the route order.
   :route-priority [{:models #{"glm-5v-turbo" "glm-4.6v" "glm-4.5v"} :provider-ids #{"zai"}}
                    {:models #{"kimi-k2.5" "kimi"} :provider-ids #{"ollama-cloud"}}
                    {:model-prefix "qwen" :provider-prefix "ollama"}
                    {:model-contains ":" :provider-prefix "ollama"}]}

  ;; auto:cephalon: pick among ranked candidates by these preference lists.
  :chains/cephalon
  {:preferred-models ["gpt-5.4-nano" "gpt-5.3-nano" "gpt-5.2-nano" "gpt-5.1-nano" "gpt-5-nano"
                      "gpt-5.4-mini" "gpt-5.3-mini" "gpt-5.2-mini" "gpt-5.1-mini" "gpt-5-mini"
                      "glm-4-flash" "glm-4.7" "qwen3.5:0.6b" "qwen3.5:1.5b" "qwen3.5:2b" "qwen3.5:4b"]
   :ollama-preferred ["gpt-oss:20b" "gpt-oss:120b" "qwen3-coder:480b" "gemma3:27b" "gemma3:12b" "gemma3:4b"]
   :ollama-fast-order ["gpt-oss:20b" "gemma3:12b" "gemma3:4b" "gemma3:27b" "gpt-oss:120b" "qwen3-coder:480b"]
   :ollama-smart-order ["gpt-oss:120b" "qwen3-coder:480b" "gemma3:27b" "gpt-oss:20b" "gemma3:12b" "gemma3:4b"]
   :empty-ranking-fallback "gpt-5-nano"}}]
