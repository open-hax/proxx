;; Provider-specific meanings of upstream failures. The attempt executor asks these
;; contracts before its generic status rules, which permanently disable an API-key
;; account on 402 and on most 403s. A quota or spend limit is not a dead credential:
;; :credential/quota-exhausted cools the account down so it recovers when the window
;; resets or the balance is topped up. More-specific (status + message) clauses
;; precede broader ones; the first match wins. Cooldowns are base values that grow
;; on repeated failures and yield to an upstream Retry-After.
[;; Kimi Code membership: quota windows are reported as 403.
 {:contract/id :credential-failure/kimi-for-coding-monthly-limit
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^kimi-for-coding$"
  :match/status 403
  :match/message-pattern "(?i)monthly usage limit"
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 86400000}

 {:contract/id :credential-failure/kimi-for-coding-usage-window
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^kimi-for-coding$"
  :match/status 403
  :match/message-pattern "(?i)usage limit"
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 1800000}

 {:contract/id :credential-failure/kimi-for-coding-concurrency-penalty
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^kimi-for-coding$"
  :match/status 403
  :match/message-pattern "(?i)concurrent request limit"
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 600000}

 {:contract/id :credential-failure/kimi-for-coding-membership-check
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^kimi-for-coding$"
  :match/status 402
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 600000}

 ;; OpenCode Zen: exhausted credits arrive as 402 or as 401 CreditsError.
 {:contract/id :credential-failure/zen-insufficient-balance
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^zen$"
  :match/status 401
  :match/message-pattern "(?i)insufficient (?:account )?(?:balance|funds)"
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 3600000}

 {:contract/id :credential-failure/zen-payment-required
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^zen$"
  :match/status 402
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 3600000}

 ;; Requesty: 402 is a low balance; 412 is the API key's own spend limit.
 {:contract/id :credential-failure/requesty-balance
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^requesty$"
  :match/status 402
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 3600000}

 {:contract/id :credential-failure/requesty-key-spend-limit
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^requesty$"
  :match/status 412
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 21600000}

 ;; OpenRouter: credits (402) and key or workspace budgets (403) recover; a 404 from
 ;; account provider restrictions only means this model is unavailable to the key.
 {:contract/id :credential-failure/openrouter-credits
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^openrouter$"
  :match/status 402
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 3600000}

 {:contract/id :credential-failure/openrouter-key-limit
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^openrouter$"
  :match/status 403
  :match/message-pattern "(?i)limit exceeded|budget"
  :classify/result :credential/quota-exhausted
  :classify/cooldown-ms 3600000}

 {:contract/id :credential-failure/openrouter-no-allowed-providers
  :contract/kind :credential-failure-classification
  :match/provider-pattern "^openrouter$"
  :match/status 404
  :match/message-pattern "(?i)no allowed providers"
  :classify/result :credential/model-unavailable
  :classify/cooldown-ms 21600000}]
