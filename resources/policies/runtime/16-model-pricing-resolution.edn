;; Facts behind model pricing resolution and energy estimates.
;;
;; * :model-pricing-snapshot       where the models.dev price table lives (EDN, relative to this file)
;; * :model-pricing-provider-rule  provider ids that map onto a models.dev provider, or are local (free)
;; * :model-pricing-vendor-fallback ordered model-prefix -> canonical vendor providers to try after the routed provider
;; * :model-energy-profile         ordered model patterns -> joules per token; the pattern-less profile is the default
;;
;; Clause order is semantic: the first matching vendor fallback / energy profile wins.
[{:contract/id :model-pricing-snapshot/models-dev
  :contract/kind :model-pricing-snapshot
  :snapshot/path "../../data/models-dev-pricing.edn"}

 {:contract/id :model-pricing-provider-rule/gemini
  :contract/kind :model-pricing-provider-rule
  :match/provider-id "gemini"
  :pricing/models-dev-provider "google"}

 {:contract/id :model-pricing-provider-rule/local-ollama
  :contract/kind :model-pricing-provider-rule
  :match/provider-id "local-ollama"
  :pricing/local true}

 {:contract/id :model-pricing-provider-rule/ollama
  :contract/kind :model-pricing-provider-rule
