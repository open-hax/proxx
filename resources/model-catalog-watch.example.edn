;; Public configuration only. Bind credentials in the invoking process environment.
;; Profiles must change when account/plan changes; never put keys in :scope.
{:max-age-ms 300000
 :timeout-ms 10000
 ;; New projection namespace; retain earlier reports with their original labels.
 :baseline-path ".ημ/diagnostics/provider-discovery/watch-state-v2/last-good.edn"
 :report-dir ".ημ/diagnostics/provider-discovery/watch-state-v2/reports"
 :providers
 [{:provider-id "opencode"
   :scope "local-opencode-auth:opencode"
   :endpoint "https://opencode.ai/zen/v1/models"
   :credential-env "OPENCODE_ZEN_API_KEY"
   :watch-models ["mimo-v2.6-flash-free" "nemotron-3.5-lightning-free" "nemotron-3-ultra-free"]}
  {:provider-id "opencode-go"
   :scope "local-opencode-auth:opencode-go"
   :endpoint "https://opencode.ai/zen/go/v1/models"
   :credential-env "OPENCODE_GO_API_KEY"
   :watch-models ["mimo-v2.6-flash" "mimo-v2.5" "kimi-k2.6"]}
  ;; China: runtime provider kimi-code-plan-cn; preserve the tested legacy profile.
  ;; KIMI_CN_API_KEY is this watcher's separate binding, not a native OpenCode env name.
  {:provider-id "kimi-code-plan-cn"
   :scope "local-opencode-auth:kimi-for-coding"
   :endpoint "https://api.kimi.com/coding/v1/models"
   :credential-env "KIMI_CN_API_KEY"
   :watch-models ["kimi-for-coding" "kimi-for-coding-highspeed" "k3" "k3-256k" "k2p5"]}
  ;; Overseas: runtime provider kimi-code-plan-global. Native OpenCode uses KIMI_API_KEY.
  {:provider-id "kimi-code-plan-global"
   :scope "local-opencode-auth:kimi-for-code"
   :endpoint "https://api.kimi.ai/coding/v1/models"
   :credential-env "KIMI_API_KEY"
   :watch-models ["kimi-for-coding" "kimi-for-coding-highspeed" "k3" "k3-256k" "k2p5"]}]}
