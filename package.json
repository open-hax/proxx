{
  "name": "@open-hax/proxx",
  "version": "0.3.0",
  "type": "module",
  "description": "OpenAI-compatible proxy with provider account rotation, federation, and websocket bridge.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-hax/proxx.git"
  },
  "keywords": [
    "openai",
    "proxy",
    "claude",
    "federation",
    "account-rotation",
    "llm",
    "chat-completions"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "pnpm build:cljs && node --env-file-if-exists=.env dist/cljs/main.js",
    "clean": "rm -rf dist",
    "build:cljs": "npx shadow-cljs release runtime",
    "build": "pnpm clean && pnpm build:cljs",
    "import:oauth:bulk": "npx shadow-cljs compile bulk-oauth-import && node target/bulk-oauth-import.cjs",
    "pricing:update": "node scripts/update-models-dev-pricing.mjs",
    "check:no-new-typescript": "node scripts/check-no-new-typescript.mjs && node scripts/check-policy-boundary.mjs",
    "start": "node --env-file-if-exists=.env dist/cljs/main.js",
    "test": "pnpm run build && NODE_OPTIONS=--max-old-space-size=4096 pnpm run test:cljs",
    "test:coverage": "npx shadow-cljs compile node-test && c8 --reporter=text --reporter=json-summary node target/node-test.cjs",
    "test:cljs": "npx shadow-cljs compile node-test && node target/node-test.cjs",
    "test:cljs:coverage": "npx shadow-cljs compile node-test && c8 node target/node-test.cjs",
    "test:e2e": "./scripts/e2e-test.sh",
    "test:e2e:multitenancy": "./scripts/e2e-multitenancy-smoke.sh",
    "test:e2e:federation": "./scripts/e2e-federation-cluster.sh",
    "test:e2e:federation:audit": "./scripts/e2e-federation-audit.sh",
    "test:load": "node ./scripts/load-test.mjs",
    "web:build:cljs": "rm -rf web/public/js && npx shadow-cljs release web",
    "web:watch": "npx shadow-cljs watch web",
    "web:dev": "pnpm web:build:cljs && vite --config web/vite.config.mjs",
    "web:build": "pnpm web:build:cljs && vite build --config web/vite.config.mjs",
    "web:preview": "vite preview --config web/vite.config.mjs",
    "web:test": "npx shadow-cljs compile web-test && node --require ./web/test/jsdom-setup.cjs target/web-test.cjs",
    "web:test:e2e": "node web/test/e2e/tools.smoke.mjs",
    "validate:required": "pnpm build && pnpm web:build && pnpm web:test && pnpm web:test:e2e",
    "lint": "eslint .",
    "lint:errors": "eslint . --quiet"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.3",
    "@google/genai": "^2.4.0",
    "@open-hax/uxx": "0.1.3",
    "chromadb": "^3.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fastify": "^5.0.0",
    "postgres": "^3.4.8",
    "shadow-cljs": "^3.4.10",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^13.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "^11.0.0",
    "eslint": "^9.39.1",
    "imapflow": "^1.2.13",
    "jsdom": "^22.1.0",
    "playwright": "^1.58.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "scheduler": "^0.23.2",
    "vite": "^5.4.10",
    "vitest": "^1.6.1"
  }
}
