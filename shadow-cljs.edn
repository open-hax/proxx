{:source-paths ["src" "test"]

 :dependencies
 [[metosin/malli "0.16.4"]]

 :js-options {:js-provider :import}

 :builds
 {:runtime
  {:target    :esm
   :output-dir "dist/cljs"
   :modules   {:proxx-runtime {:exports {normalizeKeys proxx.runtime/normalize-keys-js
                                          validateEntity proxx.runtime/validate-entity-js
                                          projectPheromone proxx.runtime/project-pheromone-js
                                          routePolicy proxx.runtime/route-policy-js
                                          loadPolicyEvidence proxx.runtime/load-policy-evidence-js
                                          loadModelPricingOverrides proxx.runtime/load-model-pricing-overrides-js
                                          loadProviderSeedSpecs proxx.runtime/load-provider-seed-specs-js
                                            previewPolicyDecision proxx.runtime/preview-policy-decision-js
                                            normalizeReasoningRequest proxx.runtime/normalize-reasoning-request-js
                                            resolveModelAlias proxx.runtime/resolve-model-alias-js
                                             getProviderRoutes proxx.runtime/get-provider-routes-js
                                              filterProviderRoutes proxx.runtime/filter-provider-routes-js
                                              resolveFederationRouteCandidates proxx.runtime/resolve-federation-route-candidates-js
                                              authorizeTenantProviderPolicy proxx.runtime/authorize-tenant-provider-policy-js
                                             runModelCandidates proxx.runtime/run-model-candidates-js
                                           resolveQueuePolicy proxx.runtime/resolve-queue-policy-js
                                           runQueued proxx.runtime/run-queued-js
                                           responseIndicatesQuotaError proxx.runtime/response-indicates-quota-error-js
                                           responseIndicatesMissingModel proxx.runtime/response-indicates-missing-model-js
                                           responseIndicatesModelNotSupportedForAccount proxx.runtime/response-indicates-model-not-supported-js
                                           summarizeUpstreamError proxx.runtime/summarize-upstream-error-js
                                           streamPayloadIndicatesQuotaError proxx.runtime/stream-payload-indicates-quota-error-js
                                           extractErrorMessage proxx.runtime/extract-error-message-js
                                           stripSseCommentLines proxx.runtime/strip-sse-comment-lines-js
                                           streamPayloadHasReasoningTrace proxx.runtime/stream-payload-has-reasoning-trace-js
                                           streamPayloadHasSubstantiveChunks proxx.runtime/stream-payload-has-substantive-chunks-js
                                           chatCompletionHasReasoningContent proxx.runtime/chat-completion-has-reasoning-content-js
                                           chatRequestToMessagesRequest proxx.runtime/chat-request-to-messages-request-js
                                           normalizeMessagesThinkingBudget proxx.runtime/normalize-messages-thinking-budget-js
                                           messagesToChatCompletion proxx.runtime/messages-to-chat-completion-js
                                           shouldUseMessagesUpstream proxx.runtime/should-use-messages-upstream-js
                                           isGlmModel proxx.runtime.glm/is-glm-model-js
                                           applyGlmThinking proxx.runtime.glm/apply-glm-thinking-js
                                           getFactoryModelType proxx.runtime.factory/get-factory-model-type-js
                                           getFactoryApiProvider proxx.runtime.factory/get-factory-api-provider-js
                                           getFactoryEndpointPath proxx.runtime.factory/get-factory-endpoint-path-js
                                           buildFactoryCommonHeaders proxx.runtime.factory/build-factory-common-headers-js
                                           buildFactoryAnthropicHeaders proxx.runtime.factory/build-factory-anthropic-headers-js
                                           inlineSystemPrompt proxx.runtime.factory/inline-system-prompt-js
                                           sanitizeFactorySystemPrompt proxx.runtime.factory/sanitize-factory-system-prompt-js
                                           isFkKey proxx.runtime.factory/is-fk-key-js
                                           isAutoModel proxx.runtime.auto-model/is-auto-model-js
                                           parseAutoModelType proxx.runtime.auto-model/parse-auto-model-type-js
                                           rankAutoModels proxx.runtime.auto-model/rank-auto-models-js
                                           selectAutoModel proxx.runtime.auto-model/select-auto-model-js
                                           readCookieToken proxx.runtime.http/read-cookie-token-js
                                           parseJsonIfPossible proxx.runtime.http/parse-json-if-possible-js
                                           readSingleHeader proxx.runtime.http/read-single-header-js
                                           escapeHtml proxx.runtime.http/escape-html-js
                                           normalizeRequestedModel proxx.runtime.http/normalize-requested-model-js
                                           isTrustedLocalBridgeAddress proxx.runtime.http/is-trusted-local-bridge-address-js
                                           hasBearerToken proxx.runtime.http/has-bearer-token-js
                                           queueErrorResponse proxx.runtime.http/queue-error-response-js
                                           shouldUseOllamaUpstream proxx.runtime.ollama/should-use-ollama-upstream-js
                                           chatRequestToOllamaRequest proxx.runtime.ollama/chat-request-to-ollama-request-js
                                           requestHasExplicitNumCtx proxx.runtime.ollama/request-has-explicit-num-ctx-js
                                           ollamaToChatCompletion proxx.runtime.ollama/ollama-to-chat-completion-js
                                           streamOllamaNdjsonToChatCompletionSse proxx.runtime.ollama/stream-ollama-ndjson-to-chat-completion-sse-js
                                           requestWantsReasoningTrace proxx.runtime.ollama/request-wants-reasoning-trace-js
                                           ollamaContextLengthFromShow proxx.runtime.ollama-context/ollama-context-length-from-show-js
                                           ollamaContextBudget proxx.runtime.ollama-context/ollama-context-budget-js}}}
   :js-options {:js-provider :import
                :keep-as-import #{"node:fs" "node:path"}}
   :compiler-options {:output-feature-set :es-next
                      :infer-externs :auto
                      :source-map true}}

  :node-test
  {:target      :node-test
   :output-to   "target/node-test.cjs"
   :ns-regexp   "proxx\\..*-test$"
   :compiler-options {:source-map true}}

  :node-e2e
  {:target      :node-test
   :output-to   "target/node-e2e.cjs"
   :ns-regexp   "proxx\\.e2e\\..*-test$"
   :compiler-options {:source-map true}}}}
