{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/schemas/jscpd-schema.json",
  "path": [
    "src",
    "test",
    "web/src",
    "web/test",
    "scripts",
    "resources",
    "deploy",
    "examples",
    "pseudo"
  ],
  "format": [
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "clojure"
  ],
  "mode": "mild",
  "minLines": 8,
  "minTokens": 80,
  "reporters": [
    "console",
    "html",
    "json"
  ],
  "output": "reports/jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.git/**",
    "**/.worktrees/**",
    "**/.eta-mu/**",
    "**/.ημ/**",
    "**/.shadow-cljs/**",
    "**/.clj-kondo/**",
    "**/.cpcache/**",
    "**/.lsp/**",
    "**/.vite/**",
    "**/target/**",
    "**/.target/**",
    "**/.factory/**",
    "**/.tmp-go-bin/**",
    "**/data/**",
    "**/reports/jscpd/**",
    "**/src/lib/data/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/bun.lock",
    "**/*.tsbuildinfo",
    "**/*.timestamp-*.mjs",
    "**/*.d.ts",
    "**/*.min.js",
    "**/*.map",
    "**/*.bak",
    "**/*.backup"
  ],
  "gitignore": true,
  "absolute": false,
  "blame": false
}
